<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/bg_auth">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:padding="22dp">

        <TextView
            android:id="@+id/logo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="R1K1.SYS"
            android:textColor="#FF2341"
            android:textSize="42sp"
            android:textStyle="bold"
            android:shadowColor="#99B026FF"
            android:shadowRadius="26"
            android:shadowDx="0"
            android:shadowDy="0" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingTop="4dp"
            android:paddingBottom="26dp"
            android:text="PRIVATE NETWORK  //  ACCESS"
            android:textColor="#8A7A99"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="18dp">

            <LinearLayout
                android:id="@+id/step_phone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingBottom="6dp"
                android:text="Сервер"
                android:textColor="#C9B8DB"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/server"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_input"
                android:padding="12dp"
                android:singleLine="true"
                android:inputType="textUri"
                android:textColor="#FFFFFF"
                android:textColorHint="#5E5470"
                android:hint="адрес или https://адрес" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingBottom="6dp"
                android:text="Номер из бота R1K1.SYS"
                android:textColor="#C9B8DB"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/phone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_input"
                android:padding="12dp"
                android:singleLine="true"
                android:inputType="phone"
                android:textColor="#FFFFFF"
                android:textColorHint="#5E5470"
                android:hint="+7 900 123-45-67" />

            <Button
                android:id="@+id/btn_request"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_button"
                android:onClick="onRequestCode"
                android:text="Получить код"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/step_code"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Введите код"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/code_info"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:paddingTop="8dp"
                    android:paddingBottom="18dp"
                    android:textColor="#C9B8DB"
                    android:textSize="13sp" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="58dp">

                    <LinearLayout
                        android:id="@+id/cells"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:gravity="center" />

                    <EditText
                        android:id="@+id/code"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@android:color/transparent"
                        android:textColor="#00000000"
                        android:cursorVisible="false"
                        android:inputType="number"
                        android:maxLength="5" />
                </FrameLayout>

                <Button
                    android:id="@+id/btn_verify"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/bg_button"
                    android:onClick="onVerify"
                    android:text="Войти"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btn_resend"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_button_ghost"
                    android:onClick="onResend"
                    android:textColor="#B98CFF" />

                <Button
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_button_ghost"
                    android:onClick="onChangeNumber"
                    android:text="Изменить номер"
                    android:textColor="#8A7A99" />
            </LinearLayout>

            <TextView
                android:id="@+id/status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="12dp"
                android:textColor="#FF7A92"
                android:textSize="13sp" />
        </LinearLayout>

        <Button
            android:id="@+id/button2"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_button_ghost"
            android:onClick="onViewHelp"
            android:text="@string/howTo"
            android:textColor="#B98CFF" />
    </LinearLayout>
</ScrollView>
